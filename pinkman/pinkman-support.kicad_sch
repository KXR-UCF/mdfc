	(text "7A  CONVERTER SUPPORT / 5 V INPUT ONLY"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "0aec2cfe-bf16-48b8-8909-b2a8cf9f2836")
	)
	(text "Default: R8 NOT fitted, so J2 supplies no DC (passive antenna or externally powered active antenna).\nFor a compatible 3.3V active antenna: verify current <=50mA and fit R8. Add antenna short protection if required.\nRF_IN is DC-blocked internally. Route J2 to U3 RF_IN as 50-ohm transmission line over continuous GND.\nThe 433 MHz radio antenna cannot be used as the GNSS antenna. Confirm actual antenna before assembly."
		(exclude_from_sim no)
		(at 20 250 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "2acbcc45-6e11-40f1-8f28-5728c432da0d")
	)
	(text "8  GNSS ANTENNA INTERFACE"
		(exclude_from_sim no)
		(at 20 196 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "63c837c9-0728-4e53-a8a7-79b19ae98959")
	)
	(text "U5 support components. Nets match page 1. Place input/boost/output parts tightly around U5 on PCB."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "ace4ab6b-76c6-4a69-adc0-ae5daa8879d5")
	)
	(text "Input / GND flags represent mainboard supply. +3V3 flag represents U5 output after L1.\nU5 ITH = INTVCC: internal compensation. RT = INTVCC: 2 MHz. MODE/SYNC = GND: forced continuous.\nU5 exposed pad 17 is SGND: solder and join quiet feedback ground to power ground near the IC.\nVIN pins 13/14 and RUN pin 12 use +5V_IN. VON pin 7 senses +3V3 after the inductor."
		(exclude_from_sim no)
		(at 20 166 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left)
		)
		(uuid "c9986b5d-1f96-43c1-894b-f6e5728491df")
	)
